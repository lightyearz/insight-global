{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python3 .claude/scripts/*)",
      "Bash(ruff:*)",
      "Bash(python3 -m ruff:*)",
      "Bash(pytest:*)",
      "Bash(python3 -m pytest:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/guard-bash.sh",
            "timeout": 10,
            "statusMessage": "Checking command guardrails..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/post-edit.sh",
            "timeout": 120,
            "statusMessage": "Formatting and linting..."
          }
        ]
      }
    ]
  }
}
