# Copy to api/.env (API) and web/.env.local (web). Never commit real values.
# Leave everything empty to run fully offline in replay mode.

# --- Mode selection: auto | vertex | gemini_api | replay  /  auto | live | replay
LLM_PROVIDER=auto
DATA_MODE=auto

# --- Vertex AI (Application Default Credentials; no key needed)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# --- Gemini Developer API (secret; only if not using Vertex)
GEMINI_API_KEY=

# --- Models
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MODEL_LITE=gemini-3.5-flash-lite

# --- NCBI E-utilities (optional identification; API key optional, secret)
NCBI_TOOL=health-briefing-poc
NCBI_EMAIL=
NCBI_API_KEY=

# --- Storage / fixtures (paths relative to api/)
DATA_DIR=./data
FIXTURES_DIR=../fixtures/replay
# Live mode only: record sources + LLM outputs to DATA_DIR/recordings/<slug>.<id>/, promoted to FIXTURES_DIR/<slug>/
# after a successful run unless that fixture exists (RECORD_OVERWRITE=true replaces it)
RECORD_FIXTURES=false
RECORD_OVERWRITE=false

# --- LLM tuning
GEMINI_THINKING_LEVEL=low
GEMINI_THINKING_LEVEL_CONFLICTS=low
LLM_MAX_OUTPUT_TOKENS=16384

# --- Abuse limits (no auth in this POC): concurrent runs and new-briefing rate per user
MAX_ACTIVE_RUNS=4
MAX_ACTIVE_RUNS_PER_USER=2
CREATE_RATE_PER_MINUTE=6
CREATE_BURST=3

# --- CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000

# --- Web (web/.env.local): where the Next.js server proxies /api/* (read at build / dev start)
API_BASE_URL=http://localhost:8080
# api (default) | mock (UI on built-in mock data, no API needed)
NEXT_PUBLIC_API_MODE=api
